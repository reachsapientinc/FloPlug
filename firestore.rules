rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isProductAdmin() {
      return isSignedIn() &&
        request.auth.token.get('role', '') in
          ['product_admin', 'developer', 'admin_sales'] &&
        request.auth.token.get('isAdmin', 'false') == true;
    }

    function isHubAdmin() {
      return isSignedIn() &&
        request.auth.token.get('isHubAdmin', false) == true;
    }

    function belongsToHub(hubId, tenantId) {
      return isSignedIn() &&
        request.auth.token.get('hubId',    '') == hubId &&
        request.auth.token.get('tenantId', '') == tenantId;
    }

    function hasPermission(perm) {
      return isSignedIn() &&
        perm in request.auth.token.get('permissions', []);
    }

    function canReadTenantFloData(hubId, tenantId) {
      return isProductAdmin() ||
        (belongsToHub(hubId, tenantId) && hasPermission('view:logs'));
    }

    function canReadTenantFloAlerts(hubId, tenantId) {
      return isProductAdmin() ||
        (belongsToHub(hubId, tenantId) &&
          (isHubAdmin() || hasPermission('view:logs')));
    }

    // ── CollectionGroup — Tenants slug resolution (BEFORE login) ─────────────

    match /{path=**}/Tenants/{tenantId} {
      allow read: if true;
    }

    // ── Product dashboard: cross-hub collectionGroup on Flo* tenant data ─────
    // FloAlerts / FloValidation / FloNodeRecords / FloExecutionLog live under
    // FloPlugHubs/{hubId}/Tenants/{tenantId}/ — never at hub root without tenant.

    match /{path=**}/FloAlerts/{alertId} {
      allow read, write: if isProductAdmin();
    }

    match /{path=**}/FloValidation/{floId} {
      allow read, write: if isProductAdmin();
    }

    match /{path=**}/FloNodeRecords/{nodeId} {
      allow read, write: if isProductAdmin();
    }

    match /{path=**}/FloExecutionLog/{runId} {
      allow read, write: if isProductAdmin();
    }

    // Legacy execution log path (read-only for hub users; product admin via group above)
    match /{path=**}/ExecutionLog/{runId} {
      allow read: if isProductAdmin();
      allow write: if isProductAdmin();
    }

    // ── FloPlugGlobalSettings ─────────────────────────────────────────────────

    match /FloPlugGlobalSettings/{allChildren=**} {
      allow read:  if isSignedIn();
      allow write: if isProductAdmin();
    }

    // ── FloPlugRegistry (product-level) ───────────────────────────────────────

    match /FloPlugRegistry/{globalConfigId} {
      allow read:  if isSignedIn();
      allow write: if isProductAdmin();

      match /Registry/{regDocId} {
        allow read:  if isSignedIn();
        allow write: if isProductAdmin();
      }
    }

    // ── FloPlugConnectors (product-level) ─────────────────────────────────────

    match /FloPlugConnectors/{connectorId} {
      allow read:  if isSignedIn();
      allow write: if isProductAdmin();

      match /Schemas/{schemaId} {
        allow read:  if isSignedIn();
        allow write: if isProductAdmin();
      }

      match /Actions/{actionId} {
        allow read:  if isSignedIn();
        allow write: if isProductAdmin();
      }

      match /FloKits/{floKitId} {
        allow read:  if isSignedIn();
        allow write: if isProductAdmin();

        match /FloKitActions/{actionId} {
          allow read:  if isSignedIn();
          allow write: if isProductAdmin();
        }

        match /ActionNodes/{actionNodeId} {
          allow read:  if isSignedIn();
          allow write: if isProductAdmin();
        }
      }

      match /ActionNodes/{actionId} {
        allow read:  if isSignedIn();
        allow write: if isProductAdmin();
      }
    }

    // ── FloPlugAdmins (product-level) ─────────────────────────────────────────

    match /FloPlugAdmins/{uid} {
      allow read:  if isProductAdmin() || request.auth.uid == uid;
      allow write: if isProductAdmin();
    }

    match /FloPlugTiers/{tierId} {
      allow read:  if isSignedIn() && (isHubAdmin() || isProductAdmin());
      allow write: if isProductAdmin();
    }

    // ── FloPlugHubs ───────────────────────────────────────────────────────────

    match /FloPlugHubs/{hubId} {
      allow read:  if (isProductAdmin() || isSignedIn() &&
                      request.auth.token.get('hubId', '') == hubId);
      allow write: if isProductAdmin();

      match /Tenants/{tenantId} {
        allow read:  if true;
        allow write: if isProductAdmin();

        match /Entitlements/{docId} {
          allow read:  if isHubAdmin() && belongsToHub(hubId, tenantId);
          allow write: if isProductAdmin();
        }

        match /Workspaces/{wsId} {
          allow read: if belongsToHub(hubId, tenantId);
          // Developers own workspaces; hub admins retain full control
          allow create: if belongsToHub(hubId, tenantId) && (
            (isHubAdmin()) ||
            (hasPermission('design:flows') &&
              request.resource.data.ownerUid == request.auth.uid)
          );
          allow update, delete: if belongsToHub(hubId, tenantId) && (
            (isHubAdmin()) ||
            (hasPermission('design:flows') &&
              resource.data.ownerUid == request.auth.uid)
          );

          match /FloConnections/{connectionId} {
            allow read: if belongsToHub(hubId, tenantId);
            allow write: if isProductAdmin() || (isHubAdmin() && belongsToHub(hubId, tenantId));
          }

          match /Flos/{floId} {
            allow read:  if belongsToHub(hubId, tenantId);
            allow write: if belongsToHub(hubId, tenantId) && hasPermission('design:flows');

            match /Versions/{versionId} {
              allow read:  if belongsToHub(hubId, tenantId);
              allow write: if belongsToHub(hubId, tenantId) && hasPermission('design:flows');
            }
          }
        }

        match /Plugs/{plugId} {
          allow read: if belongsToHub(hubId, tenantId) &&
                         (isHubAdmin() || !('credentials' in resource.data));
          allow write: if isHubAdmin() && belongsToHub(hubId, tenantId);
        }

        match /Users/{uid} {
          allow read:  if belongsToHub(hubId, tenantId) ||
                          (isSignedIn() && request.auth.uid == uid);
          allow create, delete: if isHubAdmin() && belongsToHub(hubId, tenantId);
          allow update: if belongsToHub(hubId, tenantId) && (
            (isHubAdmin()) ||
            (request.auth.uid == uid &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['defaultWorkspaceId', 'workspaceIds']))
          );
        }

        // ── Flo execution & validation (tenant / environment scoped) ─────────

        match /FloExecutionLog/{runId} {
          allow read:  if canReadTenantFloData(hubId, tenantId);
          allow write: if isProductAdmin();

          match /FloNodeRecords/{nodeId} {
            allow read:  if canReadTenantFloData(hubId, tenantId);
            allow write: if isProductAdmin();
          }
        }

        // Legacy path — keep read access for existing runs
        match /ExecutionLog/{runId} {
          allow read:  if canReadTenantFloData(hubId, tenantId);
          allow write: if isProductAdmin();

          match /NodeRecords/{nodeId} {
            allow read:  if canReadTenantFloData(hubId, tenantId);
            allow write: if isProductAdmin();
          }

          match /FloNodeRecords/{nodeId} {
            allow read:  if canReadTenantFloData(hubId, tenantId);
            allow write: if isProductAdmin();
          }
        }

        match /FloValidation/{floId} {
          allow read:  if canReadTenantFloData(hubId, tenantId);
          allow write: if isProductAdmin();
        }

        match /FloAlerts/{alertId} {
          allow read:  if canReadTenantFloAlerts(hubId, tenantId);
          allow write: if isProductAdmin();
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
